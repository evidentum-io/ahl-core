rifiable` outcome I-D §7.4 gives a declared-mode receipt whose ENVELOPE depends on an uncarried key transition: nothing here depends on one — entry 26 is signed by `producer-1`, which version 2 lists — and §7.1 decides the `keys` listing on its own terms, a `manifest-chain` binding naming an entry index that is no manifest version at all.","type":"statement-anchored"},"claim_material":{},"envelope":{"payload":{"ahl_version":"0.4","dataset":"customers","issued_at":"2026-08-16T12:00:00Z","manifest":"sha256:6dedcc481094b4f3cb3eb1e13bf4bad4c4c91fc0f7f3f5c17ec5945e3d4e4740","origin":"batch:2026-08-16/customers-05","producer":"producer-1","record":"hmac-sha256:586e578e172477a90c475debd756127e10f82da79e2a5fd709669cc6488a1f04","type":"ingestion","valid_time":"2026-08-16T12:00:00Z"},"signatures":[{"key_id":"sha256:34750f98bd59fcfc946da45aaabe933be154a4b5094e1c4abf42866505f3c97e","sig":"base64:wYJZChfbLXmoh1QGnRFpmaACDOEd0spqmzbqe2jTiE1cClAI2JWbpuD1jbMDuJcwsweJWzO2NFBOaaCeD1Q2DQ=="}]},"governance":{"chain":[{"entry_index":0,"envelope":{"payload":{"ahl_version":"0.4","datasets":{"customers":{"authority":{"key_ids":["sha256:34750f98bd59fcfc946da45aaabe933be154a4b5094e1c4abf42866505f3c97e"],"producer":"producer-1"},"canonicalization":"jcs","commitment_mode":"keyed","key_access":"authorized-verifiers-only"},"scores":{"canonicalization":"jcs","commitment_mode":"plain","key_access":"not-applicable"}},"issued_at":"2026-08-16T12:00:00Z","keys":[{"key_id":"sha256:34750f98bd59fcfc946da45aaabe933be154a4b5094e1c4abf42866505f3c97e","pubkey":"base64:iojj3XQJ8ZX9UtstPLpdcspnCb8dlBIb83SIAbQPb1w="}],"level":"L3","log":{"adaptor":{"hash":"sha256:ea4e9a7d9f4c2286fe2a0a292e939ef6c2261c8567b3d91cd7375c5490525961","id":"ahl-test-log-v1"},"cadence_epoch":"2026-08-16T11:30:00Z","checkpoint_cadence":"PT1H","keys":[{"key_id":"sha256:b62e867fa2f33afe62d5d6b1642e1621d543307846b2a57b897e710919b76709","pubkey":"base64:7UkoxijRwsbq6QM4kFmVYSlZJzpcY/k2NsFGFKyHN9E=","valid_from_index":0}],"log_id":"sha256:f9