d artifact whose digest differs is `invalid`. The corollary is the reason this corpus pins a stand-in at all: a verifier cannot tell a test pin from a production one, so the corpus must not create a pin that could be replayed as one.","type":"statement-anchored"},"claim_material":{},"envelope":{"payload":{"ahl_version":"0.4","dataset":"customers","issued_at":"2026-08-16T12:00:00Z","manifest":"sha256:c5937d8fc9fcf7994c08f389258c270e5a4fba2460da6ed68e5b5007658df817","origin":"batch:2026-08-16/atl-02","producer":"producer-1","record":"hmac-sha256:9d203cbd1f61135e646895c72d1408d052488be29015bead9ee1d9fe8f1f5d80","type":"ingestion","valid_time":"2026-08-16T12:00:00Z"},"signatures":[{"key_id":"sha256:34750f98bd59fcfc946da45aaabe933be154a4b5094e1c4abf42866505f3c97e","sig":"base64:22JXsp2GIeWqjUBKDTBj/X3JEcyRxZj/aY1G4MZ/XTgBX2pQvZdBUF1/6A6maF8JFGdcznOShgevEzUY4b1+Cw=="}]},"governance":{"chain":[{"entry_index":0,"envelope":{"payload":{"ahl_version":"0.4","datasets":{"customers":{"authority":{"key_ids":["sha256:34750f98bd59fcfc946da45aaabe933be154a4b5094e1c4abf42866505f3c97e"],"producer":"producer-1"},"canonicalization":"jcs","commitment_mode":"keyed","key_access":"authorized-verifiers-only"},"scores":{"canonicalization":"jcs","commitment_mode":"plain","key_access":"not-applicable"}},"issued_at":"2026-08-16T12:00:00Z","keys":[{"key_id":"sha256:34750f98bd59fcfc946da45aaabe933be154a4b5094e1c4abf42866505f3c97e","pubkey":"base64:iojj3XQJ8ZX9UtstPLpdcspnCb8dlBIb83SIAbQPb1w="}],"level":"L3","log":{"adaptor":{"hash":"sha256:79909b572dbd36added11a3087b04f0b81b09894be3c55b80825557f05d189cf","id":"ahl-adaptor-atl-v1"},"cadence_epoch":"2026-08-16T11:30:00Z","checkpoint_cadence":"PT1H","keys":[{"key_id":"sha256:b62e867fa2f33afe62d5d6b1642e1621d543307846b2a57b897e710919b76709","pubkey":"base64:7UkoxijRwsbq6QM4kFmVYSlZJzpcY/k2NsFGFKyHN9E=","valid_from_index":0}],"log_id":"sha256:d66fef87c0f962f116952b4fc318d76686d5625b8d43cf22d608bb20f79638ae","operator":"log-operator-1","witness_grace_per