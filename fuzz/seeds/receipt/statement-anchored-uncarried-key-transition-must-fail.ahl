effective-derived-rotated-key.ahl` carries the same entry-19 envelope under enumerated currency and ACCEPTS. A verifier that reported this file as `invalid` would be in contradiction with that one over the same bytes; a verifier that accepted it would be treating an unproven key as active. Refusing under a variant of its own is neither.","type":"statement-anchored"},"claim_material":{},"envelope":{"payload":{"ahl_version":"0.4","dataset":"scores","issued_at":"2026-08-16T12:00:00Z","manifest":"sha256:437053c55efe84c0b4c774140206689576bea846e08ec1381b3df0dfc12ba588","producer":"producer-1","reason_code":"superseded","record":"sha256:e4fccbcb05345bc70f1327bb001a1bb09f85df01de4e35b3778089aed70f24c4","scope":{"effective_from":"2026-08-16T12:00:00Z","retroactive":true},"type":"retraction","valid_time":"2026-08-16T12:00:00Z"},"signatures":[{"key_id":"sha256:6a3803d5f059902a1c6dafbc9ba4729212f7caac08634cc3ae76b27529f03827","sig":"base64:WQXotR5bebILFbMpNXvCbK+rrf27+v7OSPZQf3QytbxnToCeEt/szEZ6SoM0ESFAMcV9Ikt39aWw5u+og0LoAw=="}]},"governance":{"chain":[{"entry_index":0,"envelope":{"payload":{"ahl_version":"0.4","datasets":{"customers":{"authority":{"key_ids":["sha256:34750f98bd59fcfc946da45aaabe933be154a4b5094e1c4abf42866505f3c97e"],"producer":"producer-1"},"canonicalization":"jcs","commitment_mode":"keyed","key_access":"authorized-verifiers-only"},"scores":{"canonicalization":"jcs","commitment_mode":"plain","key_access":"not-applicable"}},"issued_at":"2026-08-16T12:00:00Z","keys":[{"key_id":"sha256:34750f98bd59fcfc946da45aaabe933be154a4b5094e1c4abf42866505f3c97e","pubkey":"base64:iojj3XQJ8ZX9UtstPLpdcspnCb8dlBIb83SIAbQPb1w="}],"level":"L3","log":{"adaptor":{"hash":"sha256:ea4e9a7d9f4c2286fe2a0a292e939ef6c2261c8567b3d91cd7375c5490525961","id":"ahl-test-log-v1"},"cadence_epoch":"2026-08-16T11:30:00Z","checkpoint_cadence":"PT1H","keys":[{"key_id":"sha256:b62e867fa2f33afe62d5d6b1642e1621d543307846b2a57b897e710919b76709","pubkey":"base64:7UkoxijRwsbq6QM4kFmVYSlZJzpcY/k2NsFGFKyHN9